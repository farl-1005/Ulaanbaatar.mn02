{
  "name": "ulaanbaatar-mn",
  "version": "1.0.0",
  "private": true,
  "description": "ulaanbaatar.mn: Нийслэлийн порталын шинэчилсэн концепц",
  "scripts": {
    "dev": "concurrently -k -n server,admin -c blue,magenta \"nodemon\" \"npm run dev -w admin\"",
    "build": "tsc -p server && node dist/server/cli.js build && npm run build -w admin",
    "build:server": "tsc -p server",
    "build:admin": "npm run build -w admin",
    "news": "tsc -p server && node dist/server/cli.js news",
    "start": "node dist/server/main.js"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "concurrently": "^9.2.5",
    "http-proxy-middleware": "^3.0.7",
    "lucide": "0.469.0",
    "nodemon": "^3.1.14",
    "sharp": "^0.35.5",
    "tailwindcss": "3.4.17",
    "typescript": "~5.9.3"
  },
  "engines": {
    "node": ">=20.12"
  },
  "nodemonConfig": {
    "watch": [
      "server"
    ],
    "ext": "ts",
    "exec": "tsc -p server && node dist/server/main.js --dev",
    "delay": 200
  },
  "dependencies": {
    "@nestjs/common": "^11.2.7",
    "@nestjs/core": "^11.2.7",
    "@nestjs/platform-express": "^11.2.7",
    "better-sqlite3": "^13.0.3",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "workspaces": [
    "admin"
  ]
}
