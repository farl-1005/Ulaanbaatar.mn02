# .env файл болгон хуулж утгаа оруулна. Хэрэггүй мөрийг # тэмдэгтэй үлдээнэ (хоосон утгатай мөр бүү үлдээ).
# npm run dev анх асахдаа ADMIN_PASSWORD-тэй .env-г автоматаар үүсгэнэ. VPS дээр deploy/setup-ubuntu.sh үүсгэнэ.

# Admin-ы нууц үг (заавал)
ADMIN_PASSWORD=

# Домэйн нэр (VPS, docker compose). Домэйнгүй бол # тэмдэгтэй үлдээнэ
# DOMAIN=ulaanbaatar.example.mn

# Агаарын чанар: IQAir / AirVisual түлхүүр (https://dashboard.iqair.com → API → Community plan, үнэгүй). Серверт л хадгалагдана.
# IQAIR_API_KEY=

# Газрын зургийн түлхүүр: hamuga.mn API Hub → App → «UB Engineering Map server». Серверт л хадгалагдана, хөтөч рүү гарахгүй.
# HAMUGA_API_KEY=

# Мэдээний холбоос, Facebook share, sitemap-д гарах сайтын хаяг. Тохируулаагүй бол DOMAIN-оос (https://DOMAIN) авна.
# SITE_URL=https://ulaanbaatar.example.mn

# --- Доорх нь зөвхөн Docker-гүй ажиллуулахад (npm start). Docker-д Dockerfile өөрөө тохируулдаг. ---
# PORT=3000
# TRUST_PROXY=1            # nginx г.м. reverse proxy ард бол
# DATA_DIR=./data          # өгөгдлийн сан, зураг
# NEWS_REFRESH_MIN=15      # мэдээ шинэчлэх давтамж (минут)
